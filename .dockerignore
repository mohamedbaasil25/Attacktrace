# Root-level: both plant-emulator and backend build with the repo root as context, so this keeps
# the build context small (node_modules etc. are otherwise sent to the Docker daemon every build).
.git
.venv
backend/.venv
backend/__pycache__
backend/.mypy_cache
backend/.ruff_cache
backend/.pytest_cache
backend/tests
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
data/hai
data/live
reports
submission/screenshots
submission/evidence
__pycache__
*.pyc
