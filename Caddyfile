# Phase 5.3: smallest-maintainable TLS termination in front of the existing frontend+backend.
# Caddy was chosen specifically because it needs no separate certbot/cron setup: given a real
# public domain, it provisions and renews Let's Encrypt certificates automatically with zero
# extra configuration beyond the site address below.
#
# THIS FILE, AS WRITTEN, IS FOR LOCAL/STAGING VERIFICATION ONLY -- it uses `tls internal`
# (Caddy's own internal CA, self-signed) because this environment has no public domain to obtain
# a real certificate for. Do not deploy this exact config to a real production host; see the
# commented production variant below, and the Phase 5.3 report for what was and was not verified.

{
	# Local/staging only: Caddy would otherwise try (and fail, with no public DNS/port 80/443
	# reachability) to provision a real ACME certificate for "localhost".
	local_certs
}

localhost:8443 {
	tls internal

	# Secure headers (Phase 5.3 ask): HSTS only makes sense once this is served over a real,
	# trusted TLS certificate on a real domain -- enabling it here, against a self-signed
	# internal-CA cert, would just teach browsers to distrust this host. Enable
	# Strict-Transport-Security in the production variant below once a real certificate is in use.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /ws/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		reverse_proxy frontend:80
	}
}

# ---------------------------------------------------------------------- production variant
# Replace the block above with this on a real host with a real domain pointed at it (DNS A/AAAA
# record, ports 80+443 reachable from the internet for the ACME HTTP-01 challenge). Caddy then
# obtains and renews a real Let's Encrypt certificate with no further configuration:
#
# your-real-domain.example {
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains"
# 		X-Content-Type-Options "nosniff"
# 		X-Frame-Options "DENY"
# 		Referrer-Policy "strict-origin-when-cross-origin"
# 	}
# 	handle /api/* {
# 		reverse_proxy backend:8000 {
# 			header_up X-Forwarded-For {remote_host}
# 			header_up X-Forwarded-Proto {scheme}
# 		}
# 	}
# 	handle /ws/* {
# 		reverse_proxy backend:8000 {
# 			header_up X-Forwarded-For {remote_host}
# 			header_up X-Forwarded-Proto {scheme}
# 		}
# 	}
# 	handle {
# 		reverse_proxy frontend:80
# 	}
# }
#
# Also required for that variant: set `AT_TRUST_PROXY=true` (app/config.py) so the backend reads
# the real client IP from X-Forwarded-For set above instead of the proxy's own address, remove
# `ports:` from the `backend` and `frontend` services in docker-compose.yml entirely (internal
# network only -- only `caddy` needs to publish a host port at that point), and bind caddy's own
# port to `0.0.0.0:443:443` (and `0.0.0.0:80:80` for the ACME challenge and HTTP->HTTPS redirect,
# which Caddy does automatically for a real domain) instead of the loopback `8443` used here.
