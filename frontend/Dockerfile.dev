# Local development: Vite's own dev server with hot reload. Used by docker-compose.dev.yml.
# The packaged docker-compose.yml instead uses the multi-stage Dockerfile (a real static build
# behind nginx) -- see Phase 14 B8.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
